# ANTLERWOOD — zmienne środowiskowe
# Skopiuj potrzebne pozycje do Vercel → Project → Settings → Environment Variables.
# Ten plik to tylko wzór (nie zawiera prawdziwych sekretów). NIE wpisuj tu kluczy produkcyjnych.

# ---- Baza / admin / Stripe (już używane) ----
# POSTGRES_URL=            # dodawane automatycznie przez Vercel Postgres/Neon
# ADMIN_PASSWORD=          # hasło do panelu /admin.html
# AUTH_SECRET=             # openssl rand -hex 32
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PUBLIC_BASE_URL=https://twojadomena.pl   # opcjonalnie, wymusza bazowy adres

# ================= PRZELEWY24 =================
P24_MERCHANT_ID=            # ID sprzedawcy (liczba)
P24_POS_ID=                # zwykle takie samo jak MERCHANT_ID (opcjonalne)
P24_CRC=                   # klucz CRC z panelu (Konfiguracja → Bezpieczeństwo)
P24_API_KEY=               # klucz do REST API (Konfiguracja → API/Klucz do raportów)
P24_SANDBOX=1              # 1 = tryb testowy (sandbox), 0 = produkcja

# ================= PayU =================
PAYU_POS_ID=               # ID punktu płatności (POS ID)
PAYU_CLIENT_ID=            # zwykle = POS ID (OAuth client_id) — opcjonalne
PAYU_CLIENT_SECRET=        # OAuth client_secret / „protokół OAuth"
PAYU_MD5_KEY=              # drugi klucz (MD5) — do weryfikacji powiadomień
PAYU_SANDBOX=1             # 1 = sandbox, 0 = produkcja

# ================= Tpay =================
TPAY_CLIENT_ID=            # client_id z OpenAPI (Ustawienia → API/Integracja)
TPAY_CLIENT_SECRET=        # client_secret z OpenAPI
TPAY_NOTIFY_SECRET=        # kod bezpieczeństwa powiadomień (do md5sum)
TPAY_SANDBOX=1             # 1 = sandbox, 0 = produkcja
# TPAY_API_BASE=           # opcjonalnie, nadpisuje adres API
